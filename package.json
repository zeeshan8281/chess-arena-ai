{
  "name": "ai-chess-arena-validation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack",
    "dev": "next dev --hostname 127.0.0.1 --port 3217 --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3217",
    "demo": "tsx src/demo.ts",
    "worker": "tsx src/worker.ts",
    "start:hosted": "node --import tsx src/start.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "chess.js": "1.4.0",
    "next": "16.4.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-chessboard": "5.12.1",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
